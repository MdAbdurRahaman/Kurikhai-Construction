# Tabeeb Contractor Portal - Environment Configuration Template
# Duplicate this file to .env on the server and update with protected credentials.
# Ensure .env is never committed to Git and kept outside public access.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://tabeebgroup.com

# Database Connection (MySQL / MariaDB on cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tabeebgroup_portal
DB_USER=tabeebgroup_dbuser
DB_PASS=YOUR_SECURE_DATABASE_PASSWORD_HERE

# Outgoing SMTP Configuration
SMTP_HOST=mail.tabeebgroup.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=info@tabeebgroup.com
SMTP_PASS=YOUR_SECURE_EMAIL_PASSWORD_HERE
SMTP_FROM_EMAIL=info@tabeebgroup.com
SMTP_FROM_NAME=Tabeeb Contractor Leads

# Cloudflare Turnstile (Optional spam protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# First-Party Analytics / Tag Identifiers (Configured in admin settings or env)
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GSC_VERIFICATION_TOKEN=
