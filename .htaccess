Options -Indexes
RewriteEngine On

# ----------------------------------------------------------------------
# 1. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ----------------------------------------------------------------------
# 2. BLOCK SENSITIVE FILES & CONFIGURATION DIRECTORIES
# ----------------------------------------------------------------------
<FilesMatch "(^\.env(?:\..*)?$|^\.git.*$|\.(json|sqlite|sql|log|tmp|bak|md|zip|tar|gz)$|^\.cpanel\.yml$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to config/ and scripts/ directories
RedirectMatch 403 ^/(config|scripts|data|tests|ops|vendor)/.*$

# ----------------------------------------------------------------------
# 3. CANONICAL HOSTNAME & HTTPS ENFORCEMENT (Single Preferred Origin)
# ----------------------------------------------------------------------
# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.tabeebgroup\.com$ [NC]
RewriteRule ^(.*)$ https://tabeebgroup.com/$1 [R=301,L]

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ----------------------------------------------------------------------
# 4. DIRECTORY INDEX & DYNAMIC SITEMAP / API ROUTING
# ----------------------------------------------------------------------
DirectoryIndex index.php index.html

# Project assets obey the same publication gate as their case study.
RewriteRule ^(images/projects/.*)$ media.php?path=/$1 [L,QSA]

# Dynamic XML Sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Secure Lead Ingestion API Endpoint
RewriteRule ^api/leads/?$ api/leads.php [L,QSA]

# Core Clean URLs Routing to Authoritative PHP Templates
RewriteRule ^about/?$ about.php [L,QSA]
RewriteRule ^services/?$ services.php [L,QSA]
RewriteRule ^contact/?$ contact.php [L,QSA]
RewriteRule ^privacy/?$ privacy.php [L]
RewriteRule ^terms/?$ terms.php [L]

# ----------------------------------------------------------------------
# 5. DEDICATED SERVICE PAGES (High-Relevance SEO Landing Pages)
# ----------------------------------------------------------------------
RewriteRule ^(renovation-contractor-singapore|hdb-renovation|tiling-works|vinyl-flooring|painting-works|waterproofing|hacking-demolition|plumbing|electrical|ceiling-partition|reinstatement|plastering)/?$ service.php?slug=$1 [L,QSA]

# Backward compatibility for legacy /service/slug and /services/slug
RewriteRule ^service/([a-zA-Z0-9_-]+)/?$ service.php?slug=$1 [L,QSA]
RewriteRule ^services/([a-zA-Z0-9_-]+)/?$ service.php?slug=$1 [L,QSA]

# ----------------------------------------------------------------------
# 6. BLOG & PROJECTS CLEAN URLS
# ----------------------------------------------------------------------
RewriteRule ^projects/([a-zA-Z0-9_-]+)/?$ project.php?slug=$1 [L,QSA]
RewriteRule ^projects/?$ projects.php [L,QSA]
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-post.php?slug=$1 [L,QSA]
RewriteRule ^blog/?$ blog.php [L,QSA]

# ----------------------------------------------------------------------
# 7. CLEAN URL NORMALIZATION & LEGACY REDIRECTS
# ----------------------------------------------------------------------
# Redirect /index.html and /index.php to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(html|php)\ HTTP/
RewriteRule ^index\.(html|php)$ / [R=301,L]

# Redirect /page.html to /page (Strictly preserving Google verification files)
RewriteCond %{REQUEST_URI} !^/google.*\.html$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

# Internal rewrite from /page to /page.php (Authoritative PHP Pages)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)$ $1.php [L]

# Internal rewrite fallback from /page to /page.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)$ $1.html [L]
