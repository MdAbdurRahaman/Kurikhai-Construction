# Store outside the document root; symlink release .env to this file or set APP_ENV_FILE.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.tabeebgroup.com
HMAC_SECRET=REPLACE_WITH_64_HEX_CHARACTERS_FROM_32_RANDOM_BYTES
DB_HOST=localhost
DB_PORT=3306
DB_NAME=REPLACE_WITH_SEPARATE_STAGING_DATABASE
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASS=REPLACE_WITH_DATABASE_PASSWORD
SMTP_HOST=mail.tabeebgroup.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=info@tabeebgroup.com
SMTP_PASS=
SMTP_FROM_EMAIL=info@tabeebgroup.com
SMTP_FROM_NAME=Tabeeb Contractor Leads
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
GSC_VERIFICATION_TOKEN=
# Exact identity of production database, used to refuse accidental staging access.
PRODUCTION_DB_ID=localhost:3306/tabeebgroup_portal
STAGING_AUTH_USER=reviewer
STAGING_AUTH_HASH=REPLACE_WITH_BCRYPT_PASSWORD_HASH
# Staging always simulates SMTP and suppresses analytics, even if credentials are present.
